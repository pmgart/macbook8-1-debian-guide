+	if (mb81_is_macbook81(codec)) {
+		unsigned int clk = mb81_clock_coef(codec);
+
+		codec_info(codec, "MacBook8,1 speakers: codec clock %s (coef 0x1f=0x%04x)\n",
+			   clk ? "LATCHED - speakers will be silent" : "locked", clk);
+	}
+
 	return 0;
 }
 
